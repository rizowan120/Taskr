<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_xs">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkboxSubtask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:buttonTint="@color/primary" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etSubtaskTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/subtask_hint"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Taskr.Body"
        android:textColor="@color/text_primary"
        tools:text="Review documentation" />

    <ImageButton
        android:id="@+id/btnDeleteSubtask"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_delete_subtask"
        android:src="@drawable/ic_close"
        app:tint="@color/text_hint" />

</LinearLayout>
